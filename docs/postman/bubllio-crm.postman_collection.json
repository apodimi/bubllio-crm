    {
      "name": "Automations",
      "description": "Automation endpoints. Automations run actions when events happen, such as `company.created`.",
      "item": [
        {
          "name": "List Automations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/automations/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "automations",
                ""
              ]
            },
            "description": "Returns all automations.\n\nDjango route:\n`GET /api/v1/automations/`\n\nDjango view method:\n`AutomationListCreateAPIView.get`"
          },
          "response": []
        },
        {
          "name": "Create Company Created Email Automation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "",
                  "pm.test(\"Response has automation id\", function () {",
                  "    pm.expect(data).to.have.property(\"id\");",
                  "});",
                  "",
                  "if (data.id) {",
                  "    pm.environment.set(\"automation_id\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization\": \"{{organization_id}}\",\n  \"name\": \"Notify accounting when a company is created\",\n  \"trigger\": \"company.created\",\n  \"action_type\": \"send_email\",\n  \"action_config\": {\n    \"to\": [\"accounting@example.com\"],\n    \"subject\": \"New company created\",\n    \"body\": \"A new company was added to Bubllio CRM.\"\n  },\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/automations/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "automations",
                ""
              ]
            },
            "description": "Creates an active automation for `company.created`.\n\nWhen a company is created through the API, this automation sends an email using Django's configured email backend. In local development, emails are printed in the runserver terminal."
          },
          "response": []
        },
        {
          "name": "Test Automation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",

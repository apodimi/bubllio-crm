{
  "info": {
    "_postman_id": "56ff07e9-f299-4b34-a767-ecbf4515c235",
    "name": "Bubllio CRM API",
    "description": "Postman collection for the local Bubllio CRM Django REST API.\n\nImport this collection together with `bubllio-crm.local.postman_environment.json` and select the `Bubllio CRM Local` environment.\n\nRecommended flow:\n1. List Organizations\n2. Create Organization\n3. List Organizations\n4. List Companies\n5. Create Company\n6. List Companies\n7. Search Companies\n8. List Contacts\n9. Create Contact\n10. List Contacts\n11. Search Contacts\n12. Create Company Created Email Automation\n13. Test Automation\n14. List Automations\n15. Create Company\n16. List Automation Runs\n17. Delete Organization",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Organizations",
      "description": "Organization endpoints. An organization represents the workspace/tenant that owns CRM data.",
      "item": [
        {
          "name": "List Organizations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/organizations/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "organizations",
                ""
              ]
            },
            "description": "Returns all organizations.\n\nDjango route:\n`GET /api/v1/organizations/`\n\nDjango view method:\n`OrganizationListCreateAPIView.get`"
          },
          "response": []
        },
        {
          "name": "Create Organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "",
                  "pm.test(\"Response has organization id\", function () {",
                  "    pm.expect(data).to.have.property(\"id\");",
                  "});",
                  "",
                  "if (data.id) {",
                  "    pm.environment.set(\"organization_id\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nerds Lab\",\n  \"slug\": \"nerds-lab\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/organizations/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "organizations",
                ""
              ]
            },
            "description": "Creates an organization.\n\nDjango route:\n`POST /api/v1/organizations/`\n\nDjango view method:\n`OrganizationListCreateAPIView.post`\n\nThe test script stores the returned `id` into the Postman environment variable `organization_id`."
          },
          "response": []
        },
        {
          "name": "Delete Organization",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/organizations/{{organization_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "organizations",
                "{{organization_id}}",
                ""
              ]
            },
            "description": "Deletes one organization by UUID.\n\nDjango route:\n`DELETE /api/v1/organizations/<organization_id>/`\n\nDjango view method:\n`OrganizationDetailAPIView.delete`\n\nExpected success status: `204 No Content`."
          },
          "response": []
        }
      ]
    },
    {

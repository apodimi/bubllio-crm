        {
          "name": "Search Companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/companies/?search={{company_search}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "companies",
                ""
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{company_search}}",
                  "description": "Searches companies by name, email, phone number, or website when implemented in CompanyListCreateAPIView.get."
                }
              ]
            },
            "description": "Searches companies using the `search` query parameter.\n\nDjango route:\n`GET /api/v1/companies/?search=<term>`\n\nDjango view method:\n`CompanyListCreateAPIView.get`\n\nRecommended implementation: filter the queryset before serialization and use `Q(...) | Q(...)` for OR search across `name`, `email`, `phone_number`, and `website`."
          },
          "response": []
        },
        {
          "name": "Create Company",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "",
                  "pm.test(\"Response has company id\", function () {",
                  "    pm.expect(data).to.have.property(\"id\");",
                  "});",
                  "",
                  "if (data.id) {",
                  "    pm.environment.set(\"company_id\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Inc\",\n  \"email\": \"hello@acme.test\",\n  \"phone_number\": \"+306900000000\",\n  \"website\": \"https://acme.test\",\n  \"lifecycle_stage\": \"lead\",\n  \"organization\": \"{{organization_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/companies/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "companies",
                ""
              ]
            },
            "description": "Creates a company that belongs to an organization.\n\nDjango route:\n`POST /api/v1/companies/`\n\nDjango view method:\n`CompanyListCreateAPIView.post`\n\nRequires `organization_id` to contain an existing organization UUID. Run `Create Organization` first."
          },
          "response": []
        }
      ]
    },

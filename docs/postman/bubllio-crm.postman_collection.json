              "raw": "{{base_url}}/api/{{api_version}}/automations/{{automation_id}}/test/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "automations",
                "{{automation_id}}",
                "test",
                ""

# Bubllio CRM works with SQLite when DATABASE_URL is unset.
# Uncomment this line after starting the local PostgreSQL container:
# DATABASE_URL=postgresql://bubllio:bubllio@localhost:5432/bubllio

# Never use the local fallback secret in production.
# DJANGO_SECRET_KEY=replace-with-a-secure-production-secret

# Production host and HTTPS settings. Keep DJANGO_DEBUG enabled only for local
# development. Trust X-Forwarded-Proto only behind a proxy that overwrites it.
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=crm.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable these only when every subdomain is permanently HTTPS-only and the
# browser preload commitment has been reviewed.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_TRUST_X_FORWARDED_PROTO=true

# Optional one-time first-run UI. Generate a random secret with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this only on the server. Never use a VITE_* variable or commit the value.
# BUBLLIO_SETUP_TOKEN=replace-with-a-random-one-time-token

# Required when creating or using UI-managed SMTP accounts.
# Generate with the command documented in docs/architecture/email-adapters.md.
# BUBLLIO_EMAIL_ENCRYPTION_KEY=replace-with-a-fernet-key

# Public URL of the React app, used in invitation emails. Local development
# defaults to http://127.0.0.1:5173; set explicitly in deployments.
# BUBLLIO_APP_URL=https://crm.example.com

# Installation admins can be notified when a newer stable GitHub Release exists.
# Checks are read-only, cached for six hours, and never install an update.
# BUBLLIO_UPDATE_CHECK_ENABLED=true
# BUBLLIO_UPDATE_REPOSITORY=apodimi/bubllio-crm
# BUBLLIO_UPDATE_CHECK_TTL=21600
# BUBLLIO_BACKUP_MAX_AGE_HOURS=24
# BUBLLIO_RESTORE_TEST_MAX_AGE_DAYS=90

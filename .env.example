# Bubllio CRM works with SQLite when DATABASE_URL is unset.
# Uncomment this line after starting the local PostgreSQL container:
# DATABASE_URL=postgresql://bubllio:bubllio@localhost:5432/bubllio

# Never use the local fallback secret in production.
# DJANGO_SECRET_KEY=replace-with-a-secure-production-secret

# Required when creating or using UI-managed SMTP accounts.
# Generate with the command documented in docs/architecture/email-adapters.md.
# BUBLLIO_EMAIL_ENCRYPTION_KEY=replace-with-a-fernet-key

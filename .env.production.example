# Copy to .env.production on the server and replace every CHANGE_ME value.
# Never commit the real file. URL-encode special characters in DATABASE_URL.
POSTGRES_DB=bubllio
POSTGRES_USER=bubllio
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://bubllio:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/bubllio
RABBITMQ_PASSWORD=CHANGE_ME_URL_SAFE_RABBITMQ_PASSWORD

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
BUBLLIO_APP_URL=https://crm.example.com
BUBLLIO_SETUP_TOKEN=CHANGE_ME_RANDOM_ONE_TIME_TOKEN_AT_LEAST_32_CHARACTERS
BUBLLIO_EMAIL_ENCRYPTION_KEYS=CHANGE_ME_FERNET_KEY

# Optional Update Center runner. Leave disabled until the independently managed
# agent is installed, allowlisted, and reachable over its Unix socket or HTTPS.
BUBLLIO_UPDATE_AGENT_ENABLED=false
BUBLLIO_UPDATE_AGENT_URL=
BUBLLIO_UPDATE_AGENT_SOCKET=
# Compose-only runtime directory mounted read-only by compose.update-agent.yaml.
# The agent creates agent.sock as mode 0660 with group GID 10001.
BUBLLIO_UPDATE_AGENT_RUNTIME_HOST=/run/bubllio-update-agent
BUBLLIO_UPDATE_AGENT_INSTALLATION_ID=
BUBLLIO_UPDATE_AGENT_SECRET=
BUBLLIO_UPDATE_AGENT_TIMEOUT=5
BUBLLIO_UPDATE_AGENT_ALLOW_INSECURE_HTTP=false

# The update agent writes digest-pinned values here. Manual deployments may
# leave them unset and build the local images from this repository.
BUBLLIO_BACKEND_IMAGE=
BUBLLIO_FRONTEND_IMAGE=

BUBLLIO_HTTP_PORT=8080

# Conservative defaults for a small production CRM. Increase them only after
# observing sustained queue or request pressure and confirming host headroom.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_WORKER_CONCURRENCY=2

# Configure transactional SMTP once in the first-run setup screen. The optional
# DJANGO_EMAIL_* global backend is intended only for advanced fallback use.

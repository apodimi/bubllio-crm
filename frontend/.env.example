# Development only: Vite proxies /api to this backend.
API_PROXY_TARGET=http://127.0.0.1:8000
# Public build-time configuration. Never put secrets in VITE_* variables.
VITE_API_BASE_PATH=/api/v1

# Core sign-in is required. The browser reads public Keycloak settings at
# /api/v1/auth/suite/config/ from the CRM API before initializing Keycloak.
# Only local compatibility tests may set VITE_SUITE_REQUIRED=false and supply:
# VITE_SUITE_KEYCLOAK_URL=https://identity.example.com
# VITE_SUITE_KEYCLOAK_REALM=bubllio
# VITE_SUITE_KEYCLOAK_CLIENT_ID=bubllio-crm-web

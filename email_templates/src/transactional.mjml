<mjml>
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preheader }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#0f1f38" font-size="16px" line-height="25px" />
      <mj-button
        background-color="#005bef"
        border-radius="10px"
        color="#ffffff"
        font-size="16px"
        font-weight="700"
        inner-padding="14px 24px"
      />
    </mj-attributes>
    <mj-style>
      a { color: #005bef; }
      .muted a { color: #65758b !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f5f8ff" width="640px">
    <mj-section padding="32px 20px 16px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="800" letter-spacing="-0.4px" padding="0">
          <span style="color:#005bef">●</span>&nbsp; Bubllio <span style="color:#65758b;font-weight:600">CRM</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border="1px solid #dce6f6" border-radius="18px" padding="0">
      <mj-section background-color="#eaf2ff" border-radius="18px 18px 0 0" padding="28px 32px 24px">
        <mj-column>
          <mj-text color="#005bef" font-size="12px" font-weight="800" letter-spacing="1.5px" padding="0 0 10px" text-transform="uppercase">
            {{ eyebrow }}
          </mj-text>
          <mj-text color="#0f1f38" font-size="30px" font-weight="800" letter-spacing="-0.8px" line-height="38px" padding="0">
            {{ heading }}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="30px 32px 8px">
        <mj-column>
          <mj-text padding="0 0 18px">{{ message }}</mj-text>
          <mj-raw>{% if action_url %}</mj-raw>
          <mj-button align="left" href="{{ action_url }}" padding="0 0 20px">
            {{ action_label }}
          </mj-button>
          <mj-text color="#65758b" font-size="13px" line-height="20px" padding="0 0 22px">
            If the button does not work, copy and paste this address into your browser:<br />
            <a href="{{ action_url }}" style="word-break:break-all">{{ action_url }}</a>
          </mj-text>
          <mj-raw>{% endif %}</mj-raw>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8faff" border-top="1px solid #e3eaf5" padding="20px 32px" border-radius="0 0 18px 18px">
        <mj-column>
          <mj-text color="#53657d" font-size="13px" line-height="20px" padding="0">
            {{ notice }}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="20px 24px 32px">
      <mj-column>
        <mj-text css-class="muted" align="center" color="#65758b" font-size="12px" line-height="18px" padding="0">
          Sent securely by Bubllio CRM.<br />
          This is a transactional message about your account or workspace.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
